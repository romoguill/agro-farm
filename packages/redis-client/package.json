{
  "name": "@repo/redis-client",
  "version": "1.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "types": "./dist/redis.module.d.ts",
  "main": "./dist/redis.module.js",
  "exports": {
    ".": {
      "types": "./dist/redis.module.d.ts",
      "require": "./dist/redis.module.js",
      "default": "./dist/redis.module.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "prepare": "pnpm run build"
  },
  "devDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@types/node": "^22.10.7"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0"
  }
}
